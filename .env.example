# ── Database ────────────────────────────────────────────────
# PostgreSQL. Free option: https://neon.com (or the Neon integration
# in the Vercel dashboard, which sets this variable for you).
# Neon gives a pooled and a direct URL — use the pooled one here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ────────────────────────────────────────────────────
# Signs the session cookie. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-random-32-plus-character-value"

# ── File uploads (production only) ──────────────────────────
# Set automatically by Vercel when a Blob store is attached to the project.
# Leave it unset locally: uploads then go to public/uploads and public/avatars.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
