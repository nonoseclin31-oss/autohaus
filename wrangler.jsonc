{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autohausmotion",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",

  // nodejs_compat gives the Worker node:crypto, node:buffer and friends, which
  // Next, Prisma and bcryptjs all need. Without it the build fails.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Uploaded vehicle photos and avatars. Create it once with:
  //   npx wrangler r2 bucket create autohaus-motion-media
  // Re-enable once R2 is activated in the Cloudflare dashboard. Until then
  // the site works fully except uploading NEW photos; the seeded images are
  // static assets and still display.
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA",
  //     "bucket_name": "autohaus-motion-media"
  //   }
  // ]

  // DATABASE_URL, AUTH_SECRET and R2_PUBLIC_URL are secrets, not vars.
  // Set them with `npx wrangler secret put <NAME>` — never in this file,
  // which is committed.
}
