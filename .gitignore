# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# database (SQLite dev)
prisma/dev.db
prisma/dev.db-journal
*.db
*.db-journal

# uploads — user media does not belong in the repo. The seed-* fixtures do:
# they are the demo photography shipped with the app, and the deployed site
# serves them from here as static assets.
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/seed-*

# env
.env
.env*.local
!.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo

# uploaded avatars
/public/avatars/*
!/public/avatars/.gitkeep

# cloudflare / opennext build output
/.open-next/
/.wrangler/
/.wrangler-dryrun/
cloudflare-env.d.ts

# local wrangler secrets
.dev.vars
.dev.vars.*
