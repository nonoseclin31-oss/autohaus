// Autohaus Motion GmbH — data model
generator client {
  provider        = "prisma-client-js"
  // Required to run Prisma on Cloudflare Workers: the Workers runtime has no
  // raw TCP for Postgres, so queries go through the Neon serverless driver.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles: ADMIN | MANAGER | SALES | VIEWER
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              String    @default("VIEWER")
  phone             String?
  jobTitle          String?
  avatarUrl         String?
  locale            String    @default("fr")
  active            Boolean   @default(true)

  // ── The public team section on the About page ──
  /// Where this person sits in the team shown on the About page: 1 is the
  /// first card. Null — the default for every account — keeps them off the
  /// public site entirely. Only an administrator sets it.
  aboutRank   Int?
  /// Kept for the age on the About page, which is all that is ever shown of
  /// it. Stored rather than the age itself, so the page does not go stale on
  /// every birthday.
  birthDate   DateTime?
  /// The public function and one-line introduction, per language, as JSON:
  /// {"fr": {"role": "…", "tagline": "…"}, "en": {…}}. A language left empty
  /// falls back to one that is filled, so writing it once is enough.
  aboutCopy   String    @default("{}")

  // Sessions are stateless JWTs, so a stolen cookie stays valid until it
  // expires. Stamping the moment a password changed lets any token issued
  // before it be rejected — which is what makes a reset actually evict
  // whoever was using the old credentials.
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vehicles     Vehicle[]         @relation("VehicleOwner")
  toys         Toy[]             @relation("ToyOwner")
  leads        Lead[]            @relation("LeadAssignee")
  activities   ActivityLog[]
  templates    VehicleTemplate[]
  toyTemplates ToyTemplate[]     @relation("ToyTemplateAuthor")

  @@index([aboutRank])
}

model Vehicle {
  id        String @id @default(cuid())
  slug      String @unique
  reference String @unique

  // ── Identity ────────────────────────────────
  brand   String
  model   String
  version String?
  year    Int
  vin     String?

  // ── Classification ──────────────────────────
  bodyType  String // SEDAN | SUV | COUPE | CABRIOLET | ESTATE | HATCHBACK | MPV | PICKUP | VAN
  condition String  @default("USED") // NEW | USED | DEMO | CLASSIC
  segment   String? // SPORT | LUXURY | FAMILY | CITY | ELECTRIC | OFFROAD | COLLECTOR

  // ── Powertrain ──────────────────────────────
  fuel         String // PETROL | DIESEL | HYBRID | PLUGIN_HYBRID | ELECTRIC | LPG | CNG
  transmission String // MANUAL | AUTOMATIC | DUAL_CLUTCH | CVT
  gears        Int?
  drivetrain   String? // FWD | RWD | AWD | FOUR_WD
  engineSize   Float?
  cylinders    Int?
  powerHp      Int
  powerKw      Int?
  torqueNm     Int?
  acceleration Float?
  topSpeed     Int?

  // ── Energy & emissions ──────────────────────
  consumptionCombined Float?
  consumptionUrban    Float?
  consumptionHighway  Float?
  co2                 Int?
  emissionClass       String?
  energyLabel         String?
  batteryCapacity     Float?
  electricRange       Int?
  chargingTime        String?

  // ── Body & interior ─────────────────────────
  doors         Int?
  seats         Int?
  colorExterior String?
  colorInterior String?
  paintType     String? // SOLID | METALLIC | PEARL | MATTE
  upholstery    String? // LEATHER | ALCANTARA | FABRIC | VEGAN

  // ── History & condition ─────────────────────
  mileage           Int       @default(0)
  firstRegistration DateTime?
  previousOwners    Int?
  serviceHistory    Boolean   @default(false)
  warrantyMonths    Int?
  nextInspection    DateTime?
  accidentFree      Boolean   @default(true)
  nonSmoker         Boolean   @default(true)
  imported          Boolean   @default(false)

  // ── Pricing ─────────────────────────────────
  price            Int
  priceNet         Int?
  vatDeductible    Boolean @default(false)
  oldPrice         Int?
  negotiable       Boolean @default(false)
  financingMonthly Int?

  // ── Long-term rental (LLD) ──────────────────
  rentalAvailable    Boolean @default(false)
  rentalMonthly      Int?
  rentalDeposit      Int?
  rentalFirstPayment Int?
  /// Offered with a purchase option as well as on plain rental.
  loaAvailable       Boolean @default(true)
  /// Per-vehicle overrides for the quote. Null means the standard curve:
  /// the rate defaults to 4.9%, the residual to the duration/mileage table,
  /// and the services to a figure scaled from the price.
  financeRate        Float?
  residualRate       Float?
  servicesMonthly    Int?

  rentalDurations String @default("[]") // JSON: [24, 36, 48, 60]
  rentalMileages  String @default("[]") // JSON: [10000, 15000, 20000]

  // ── Equipment (JSON array of option keys) ───
  equipment String @default("[]")

  // ── Media ───────────────────────────────────
  videoUrl String?
  images   VehicleImage[]

  // ── Publication ─────────────────────────────
  status    String  @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD | COMING_SOON
  published Boolean @default(false)
  featured  Boolean @default(false)
  location  String?
  views     Int     @default(0)

  /// Where this listing sits on the home page, chosen by hand in the back
  /// office. 0 is the showcase car at the top; 1-6 are the six cards below
  /// it, in that order. Null means the listing only shows in the catalogue.
  homeRank Int?

  /// Where this listing sits at the top of the catalogue page, chosen by hand
  /// in the back office: 1 is the first card, 2 the second, and so on. Null —
  /// which is the normal case — means it takes its place by date, newest
  /// first. Deliberately separate from `homeRank`: the two pages are arranged
  /// independently, and the home page is not disturbed by this one.
  catalogRank Int?

  /// When the listing went public, which is what "newest first" means to a
  /// visitor. Distinct from `createdAt`: a car can be drafted in October and
  /// published in December, and it is December that should put it on top.
  /// Set the first time it is published, and again if it is published anew
  /// after having been taken down.
  publishedAt DateTime?

  ownerId String?
  owner   User?   @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  translations VehicleTranslation[]
  leads        Lead[]

  soldAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, published])
  @@index([homeRank])
  @@index([catalogRank])
  @@index([published, publishedAt])
  @@index([brand, model])
  @@index([rentalAvailable])
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
  isCover   Boolean @default(false)

  @@index([vehicleId, position])
}

model VehicleTranslation {
  id          String  @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  locale      String // en | fr | de | zh | ar | es
  headline    String?
  description String?

  @@unique([vehicleId, locale])
}

/// A saved set of listing values, reusable as the starting point for a new one.
/// Photos are never part of it: they belong to one car, not to a kind of car.
model VehicleTemplate {
  id   String @id @default(cuid())
  name String

  /// Shown in the picker so a template is recognisable without opening it.
  brand   String
  model   String
  version String?

  /// The form values, as JSON. Kept opaque on purpose: the vehicle form has
  /// some sixty fields and gains more over time, and a column per field would
  /// mean a migration every time one is added.
  payload String

  /// Frequently used templates sort to the top, which is what keeps the list
  /// usable once there are a few hundred of them.
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand, model])
  @@index([lastUsedAt])
  @@index([name])
}

model Lead {
  id        String  @id @default(cuid())
  type      String  @default("SALE") // SALE | RENTAL | CONTACT | TRADE_IN
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  message   String?
  locale    String  @default("fr")

  // rental request specifics
  rentalDuration Int?
  rentalMileage  Int?

  /// The offer the visitor had on screen when they asked for it, so the
  /// advisor answers the quote the customer saw rather than a fresh one.
  financeFormula String? // LLD | LOA
  downPayment    Int?
  quotedMonthly  Int?
  purchaseOption Int?
  forBusiness    Boolean @default(false)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  /// A lead can point at a car or at a Big Toy, never at both: the two
  /// catalogues are separate modules and an enquiry comes from one page.
  toyId String?
  toy   Toy?    @relation(fields: [toyId], references: [id], onDelete: SetNull)

  status       String  @default("NEW") // NEW | CONTACTED | QUALIFIED | WON | LOST
  notes        String?
  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// A keyed hash of the connection the enquiry came from — never the
  /// address itself. Only there to notice one source sending dozens of
  /// enquiries in a few minutes, which is a script and not a customer.
  sourceHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([sourceHash, createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

/// ═══════════════════════════════════════════════════════════════
/// Big Toys — motorcycles, quads, jet skis and boats.
///
/// A separate model rather than a flag on Vehicle. A jet ski has engine
/// hours and no gearbox, a boat has a hull length and a berth count, a
/// motorcycle has a licence category: half of Vehicle's sixty columns
/// would never apply, and every car query would grow a filter it could
/// forget. The two catalogues stay apart in the data and meet only in
/// the back office, which shows them side by side.
/// ═══════════════════════════════════════════════════════════════
model Toy {
  id        String @id @default(cuid())
  slug      String @unique
  reference String @unique

  /// MOTORCYCLE | QUAD | JETSKI | BOAT — decides which figures the
  /// listing shows: kilometres for the two that drive, engine hours
  /// and a hull length for the two that float.
  kind    String
  brand   String
  model   String
  version String?
  year    Int
  /// VIN on land, HIN (hull identification number) on water.
  hullId  String?

  condition String  @default("USED") // NEW | USED | DEMO
  category  String? // SPORT | TOURING | CRUISER | ADVENTURE | UTILITY | RACE | LUXURY | WATERSPORT

  // ── Powertrain ──────────────────────────────────
  engineType   String  @default("PETROL") // PETROL | ELECTRIC | DIESEL | HYBRID
  displacement Int? // cm³
  cylinders    Int?
  /// 2 or 4. A two-stroke is a selling point on water and a restriction
  /// on land, so it is a field rather than a line of prose.
  strokes      Int?
  powerHp      Int
  powerKw      Int?
  torqueNm     Int?
  topSpeed     Int? // km/h on land, knots on water
  transmission String? // MANUAL | AUTOMATIC | DCT | CVT | DIRECT
  /// Boats are routinely twin-engined and the pair is what is being sold.
  engineCount  Int?    @default(1)

  // ── Use & measurements ──────────────────────────
  mileage      Int? // km — motorcycles and quads
  engineHours  Int? // h — jet skis and boats
  dryWeight    Int? // kg
  seats        Int?
  lengthM      Float? // hull length, boats
  beamM        Float? // hull beam, boats
  fuelCapacity Float? // litres
  rangeKm      Int?

  // ── Paperwork ───────────────────────────────────
  trailerIncluded   Boolean   @default(false)
  registered        Boolean   @default(true)
  /// A1 | A2 | A | B | BOAT_INLAND | BOAT_COASTAL | NONE
  licence           String?
  warrantyMonths    Int?
  serviceHistory    Boolean   @default(false)
  accidentFree      Boolean   @default(true)
  previousOwners    Int?
  firstRegistration DateTime?

  colorExterior String?

  // ── Pricing ─────────────────────────────────────
  price            Int
  priceNet         Int?
  vatDeductible    Boolean @default(false)
  oldPrice         Int?
  negotiable       Boolean @default(false)
  financingMonthly Int?

  equipment String  @default("[]") // JSON array of option keys
  videoUrl  String?

  images       ToyImage[]
  translations ToyTranslation[]
  leads        Lead[]

  // ── Publication ─────────────────────────────────
  status    String  @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD | COMING_SOON
  published Boolean @default(false)
  featured  Boolean @default(false)
  location  String?
  views     Int     @default(0)

  /// Where this listing sits on the Big Toys page, chosen by hand in the
  /// back office. 0 is the showcase piece at the top; 1 and up are the
  /// cards below it. Null means it only shows in the catalogue below.
  homeRank Int?

  ownerId String?
  owner   User?   @relation("ToyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  soldAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, published])
  @@index([kind, published])
  @@index([homeRank])
  @@index([brand, model])
}

model ToyImage {
  id       String  @id @default(cuid())
  toyId    String
  toy      Toy     @relation(fields: [toyId], references: [id], onDelete: Cascade)
  url      String
  alt      String?
  position Int     @default(0)
  isCover  Boolean @default(false)

  @@index([toyId, position])
}

model ToyTranslation {
  id          String  @id @default(cuid())
  toyId       String
  toy         Toy     @relation(fields: [toyId], references: [id], onDelete: Cascade)
  locale      String // en | fr | de | zh | ar | es
  headline    String?
  description String?

  @@unique([toyId, locale])
}

/// A saved set of Big Toy values, reusable as the starting point for the next
/// one of the same kind — the same idea as VehicleTemplate, and separate for
/// the same reason the two catalogues are: a jet ski preset has nothing to
/// offer someone entering an estate car, and mixing them would make both
/// pickers longer and less useful.
///
/// Photos are never part of one: they belong to one machine, not to a kind.
model ToyTemplate {
  id   String @id @default(cuid())
  name String

  /// Shown in the picker so a template is recognisable without opening it,
  /// and so the four families can be told apart at a glance.
  kind    String
  brand   String
  model   String
  version String?

  /// The form values, as JSON. Kept opaque on purpose, as for vehicles: a
  /// column per field would mean a migration every time the form gains one.
  payload String

  usageCount Int       @default(0)
  lastUsedAt DateTime?

  createdBy   User?   @relation("ToyTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([brand, model])
  @@index([lastUsedAt])
  @@index([name])
}
